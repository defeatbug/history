{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "seed:generate": "bun run scripts/generate-seed.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:local:up": "./scripts/local-db.sh up",
    "db:local:down": "./scripts/local-db.sh down",
    "db:local:reset": "./scripts/local-db.sh reset",
    "db:local:psql": "./scripts/local-db.sh psql",
    "db:local:test": "./scripts/local-db.sh test",
    "cloud:setup": "./scripts/setup-cloud.sh",
    "cloud:check": "bun run scripts/check-cloud.ts",
    "lint:sh": "./scripts/lint-shell.sh",
    "db:sql": "bun run scripts/bundle-sql.ts",
    "cloud:e2e": "bun run scripts/e2e-cloud.ts",
    "dns:check": "./scripts/check-dns.sh",
    "fn:deploy": "supabase functions deploy chat",
    "fn:logs": "supabase functions logs chat",
    "fn:test": "bun run scripts/test-function.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "bun run scripts/bundle-sql.ts && supabase db query --linked --file supabase/bundle.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "axios": "^1.13.2",
    "openai": "^6.8.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.6.3",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "3.4.14",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.1"
  }
}
